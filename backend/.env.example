# PostgreSQL connection settings (e.g. Supabase).
DATABASE_HOST=<your-database-host>
DATABASE_PORT=5432
DATABASE_NAME=<your-database-name>
DATABASE_USER=<your-database-user>
DATABASE_PASSWORD=<your-database-password>

# Shared secret required by the X-API-Key header on device-actuation routes
# (POST /api/devices/{id}/pump and POST /api/devices/{id}/pump/mode).
# Required: the backend refuses to start without it, so an unset key can never
# silently leave pump actuation unprotected.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=<generate-a-random-secret-do-not-reuse-across-environments>

# JSON mapping of database device IDs to their ESP32 base URLs.
# Keep this file server-side only; never expose ESP32 URLs to the frontend.
DEVICE_CONTROL_URLS={"1":"http://192.168.1.50"}

# Comma-separated browser origins permitted to call the FastAPI API.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Optional. Days a login session stays valid before requiring a fresh
# login. Defaults to 7 if unset — see app/settings.py for the reasoning.
SESSION_TTL_DAYS=7

# Optional session cookie settings — all default to values that work for
# local dev (plain HTTP, frontend/backend on different localhost ports)
# with no changes needed. See app/settings.py for full reasoning.
# SESSION_COOKIE_NAME=verda_session
# SESSION_COOKIE_SECURE=false      # set true in production (HTTPS only)
# SESSION_COOKIE_SAMESITE=lax      # lax | strict | none (none requires Secure=true)
# SESSION_COOKIE_PATH=/
# SESSION_COOKIE_DOMAIN=           # unset = host-only cookie; e.g. .verda.io in production
